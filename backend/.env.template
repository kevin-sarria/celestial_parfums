# Claves de firma de tokens de sesión. OBLIGATORIAS y deben ser largas y aleatorias.
# En producción el servidor NO arranca si faltan (protección anti-configuración débil).
# Genera cada una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
REFRESH_SECRET=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Entorno: en "production" el CORS se restringe SOLO a FRONTEND_URL.
# En desarrollo se permite cualquier puerto de localhost automáticamente.
NODE_ENV=development

# Origen(es) permitido(s) del frontend. Admite varios separados por coma.
# Producción: FRONTEND_URL=https://www.celestialparfums.com,https://celestialparfums.com
FRONTEND_URL=http://localhost:5173

# URL pública base para construir enlaces a imágenes subidas (/api/uploads).
# Opcional: si se deja vacía, se deriva automáticamente del dominio de cada petición.
# Como las imágenes se sirven bajo /api/uploads, si el frontend y el backend
# comparten dominio detrás de nginx (proxy solo de /api) NO hace falta fijarla.
# Fíjala solo si el backend vive en su propio dominio, ej: BACKEND_URL=https://api.celestialparfums.com
BACKEND_URL=

# reCAPTCHA v3 (https://www.google.com/recaptcha/admin)
# Clave SECRETA del sitio: se usa para verificar los tokens server-side.
# En desarrollo, si se deja vacía la verificación se omite.
# ¡EN PRODUCCIÓN ES OBLIGATORIA! (si no, los bots pasan login/registro sin captcha).
RECAPTCHA_SECRET_KEY=
# Puntaje mínimo aceptado (0 a 1). 0.5 es el recomendado por Google.
RECAPTCHA_MIN_SCORE=0.5

# Inicio de sesión con Google (https://console.cloud.google.com → Credenciales → ID de cliente OAuth)
# Client ID del cliente OAuth "Aplicación web". Debe ser el MISMO que VITE_GOOGLE_CLIENT_ID del frontend.
# No se requiere el client secret para este flujo (verificación de ID token).
GOOGLE_CLIENT_ID=


