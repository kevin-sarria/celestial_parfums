generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


// ── Enums ───────────────────────────────────────────────────────────────────

enum Genero {
  dama
  caballero
  unisex
}

enum ContactoFondoTipo {
  color
  imagen
}

enum ContactoForma {
  redondo
  cuadrado
}

enum ContactoLinkTipo {
  boton
  red
}

// Alineación vertical de la sección superior (perfil+botones) dentro de su mitad.
enum ContactoPosicion {
  arriba
  centro
}

// Alineación vertical de la sección inferior (redes) dentro de su mitad.
enum ContactoRedesPosicion {
  centro
  abajo
}

enum AnuncioTipo {
  imagen
  mensaje
  descuento
}

enum AnuncioAudiencia {
  todos
  no_registrados
  registrados
}

// Ciclo de vida de un código único de descuento:
// activo (emitido, viaja en el pedido de WhatsApp) → canjeado (la venta se marcó
// pagada) | anulado (el admin lo invalidó; el cupón vuelve a quedar disponible).
enum CodigoEstado {
  activo
  canjeado
  anulado
}

// ── Models ──────────────────────────────────────────────────────────────────

model Role {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(50)
  users  User[]

  @@map("roles")
}

// Única lista de personas del sistema: cuentas web reales y "fichas" creadas
// por el admin (sin_cuenta=true, sin acceso) para clientes del negocio que aún
// no se registran. Al registrarse con el mismo correo, la ficha se reclama y
// hereda todo su historial de ventas y créditos.
model User {
  id                 Int       @id @default(autoincrement())
  nombre             String    @db.VarChar(100)
  apellido           String    @db.VarChar(100)
  email              String    @unique @db.VarChar(150)
  password           String    @db.VarChar(255)
  rol_id             Int
  activo             Boolean   @default(false)
  verification_token String?   @db.VarChar(255)
  token_expiry       DateTime?
  telefono           String?   @db.VarChar(20)
  direccion          String?   @db.VarChar(255)
  // Cupo de crédito base fijado por el admin; el factor de comportamiento lo ajusta.
  cupo_base          Decimal   @default(0) @db.Decimal(10, 2)
  // true = ficha creada por el admin, sin acceso a la web todavía.
  sin_cuenta         Boolean   @default(false)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  rol                Role      @relation(fields: [rol_id], references: [id])
  ventas             Venta[]
  creditos           Credito[]
  codigos_descuento  DescuentoCodigo[]
  recomendacion      Recomendacion?

  @@map("users")
}

model Categoria {
  id         Int       @id @default(autoincrement())
  nombre     String    @unique @db.VarChar(100)
  // Descuento general de la categoría: los perfumes lo heredan de fondo
  // (se aplica el mayor entre este % y el propio del perfume)
  descuento  Int       @default(0)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  perfumes   Perfume[]
  combos     Combo[]
  anuncios   AnuncioCategoria[]

  @@map("categorias")
}

// ── Publicidad: ventanas emergentes configurables del catálogo ──────────────
// tipo imagen/mensaje = informativo; tipo descuento = cupón de un solo uso que
// aplica a las categorías elegidas y/o combos, SIN acumularse con descuentos
// de producto ni con otros cupones.
model Anuncio {
  id            Int              @id @default(autoincrement())
  titulo        String           @db.VarChar(150)
  mensaje       String?          @db.Text
  imagen_url    String?          @db.Text
  tipo          AnuncioTipo      @default(mensaje)
  audiencia     AnuncioAudiencia @default(todos)
  // true = cada visitante lo ve una sola vez; false = en cada visita
  una_vez       Boolean          @default(true)
  activo        Boolean          @default(true)
  orden         Int              @default(0)
  inicio        DateTime?        @db.Date
  fin           DateTime?        @db.Date
  // Solo tipo descuento:
  descuento_pct Int              @default(0) @db.UnsignedTinyInt
  aplica_combos Boolean          @default(false)
  // Reglas para que el cupón aplique en el carrito (0 = sin mínimo):
  // unidades mínimas de productos cubiertos y monto mínimo de esos productos.
  min_unidades  Int              @default(0) @db.UnsignedSmallInt
  min_monto     Decimal          @default(0) @db.Decimal(10, 2)
  // Guardarraíles del cupón (0 = sin límite): tope del descuento en pesos por
  // canje y cupo total de códigos que la campaña puede emitir.
  max_descuento Decimal          @default(0) @db.Decimal(10, 2)
  max_canjes    Int              @default(0) @db.UnsignedSmallInt
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt
  categorias    AnuncioCategoria[]
  codigos       DescuentoCodigo[]

  @@index([activo])
  @@map("anuncios")
}

// Categorías de perfume a las que aplica un cupón (contratipos, 1.1, originales…)
model AnuncioCategoria {
  anuncio_id   Int
  categoria_id Int
  anuncio      Anuncio   @relation(fields: [anuncio_id], references: [id], onDelete: Cascade)
  categoria    Categoria @relation(fields: [categoria_id], references: [id], onDelete: Cascade)

  @@id([anuncio_id, categoria_id])
  @@map("anuncio_categorias")
}

// Código único de descuento emitido al enviar un pedido con cupón. Viaja en el
// mensaje de WhatsApp; el admin lo valida en el dashboard y se canjea (un solo
// uso) al marcar la venta como pagada. Máximo un código activo por persona y
// por tipo de cupón (categorías/combos que cubre).
model DescuentoCodigo {
  id          Int          @id @default(autoincrement())
  codigo      String       @unique @db.VarChar(20)
  anuncio_id  Int
  // null = visitante sin cuenta
  user_id     Int?
  estado      CodigoEstado @default(activo)
  // Venta donde se canjeó (o quedó reservado si la venta sigue pendiente de pago)
  venta_id    Int?         @unique
  created_at  DateTime     @default(now())
  canjeado_at DateTime?
  anuncio     Anuncio @relation(fields: [anuncio_id], references: [id], onDelete: Cascade)
  user        User?   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  venta       Venta?  @relation(fields: [venta_id], references: [id], onDelete: SetNull)

  @@index([user_id, estado])
  @@index([anuncio_id])
  @@map("descuento_codigos")
}

// "Tu perfume ideal": cálculo guardado por usuario. Al volver al apartado se
// muestra tal cual (sin recalcular); solo se recalcula si cambia sus respuestas.
model Recomendacion {
  id         Int      @id @default(autoincrement())
  user_id    Int      @unique
  // Respuestas del quiz (género, edad, ocasiones, aromas, presupuesto, etc.)
  filtros    Json
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items      RecomendacionItem[]

  @@map("recomendaciones")
}

model RecomendacionItem {
  recomendacion_id Int
  perfume_id       Int
  orden            Int
  // Afinidad 0-100 con el perfil de la persona
  puntaje          Int    @db.UnsignedTinyInt
  // JSON string con las razones legibles del match ("Ideal para Citas", ...)
  razones          String @db.Text
  recomendacion    Recomendacion @relation(fields: [recomendacion_id], references: [id], onDelete: Cascade)
  perfume          Perfume       @relation(fields: [perfume_id], references: [id], onDelete: Cascade)

  @@id([recomendacion_id, perfume_id])
  @@index([perfume_id])
  @@map("recomendacion_items")
}

model Perfume {
  id           Int                @id @default(autoincrement())
  nombre       String             @db.VarChar(150)
  descripcion  String?            @db.Text
  precio       Decimal            @db.Decimal(10, 2)
  duracion     String?            @db.VarChar(50)
  proyeccion   String?            @db.VarChar(50)
  imagen_url   String?            @db.Text
  genero       Genero?
  categoria_id Int?
  descuento    Int                @default(0) @db.UnsignedTinyInt
  agotado      Boolean            @default(false)
  created_at   DateTime           @default(now())
  updated_at   DateTime           @updatedAt
  categoria    Categoria?         @relation(fields: [categoria_id], references: [id], onDelete: SetNull)
  tipos_aroma    PerfumeTipoAroma[]
  ocasiones      PerfumeOcasion[]
  presentaciones PerfumePresentacion[]
  ventas         VentaPerfume[]
  recomendado_en RecomendacionItem[]

  @@index([categoria_id])
  @@index([genero])
  @@index([nombre])
  @@map("perfumes")
}

model TipoAroma {
  id         Int                @id @default(autoincrement())
  nombre     String             @unique @db.VarChar(100)
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt
  perfumes   PerfumeTipoAroma[]

  @@map("tipos_aroma")
}

model PerfumeTipoAroma {
  perfume_id    Int
  tipo_aroma_id Int
  perfume       Perfume   @relation(fields: [perfume_id], references: [id], onDelete: Cascade)
  tipo_aroma    TipoAroma @relation(fields: [tipo_aroma_id], references: [id], onDelete: Cascade)

  @@id([perfume_id, tipo_aroma_id])
  @@map("perfume_tipo_aroma")
}

model Ocasion {
  id         Int              @id @default(autoincrement())
  nombre     String           @unique @db.VarChar(100)
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt
  perfumes   PerfumeOcasion[]

  @@map("ocasiones")
}

model PerfumeOcasion {
  perfume_id Int
  ocasion_id Int
  perfume    Perfume @relation(fields: [perfume_id], references: [id], onDelete: Cascade)
  ocasion    Ocasion @relation(fields: [ocasion_id], references: [id], onDelete: Cascade)

  @@id([perfume_id, ocasion_id])
  @@map("perfume_ocasion")
}

model Presentacion {
  id         Int                   @id @default(autoincrement())
  nombre     String                @unique @db.VarChar(20)
  created_at DateTime              @default(now())
  updated_at DateTime              @updatedAt
  perfumes   PerfumePresentacion[]
  combos     Combo[]

  @@map("presentaciones")
}

model PerfumePresentacion {
  perfume_id      Int
  presentacion_id Int
  perfume         Perfume      @relation(fields: [perfume_id], references: [id], onDelete: Cascade)
  presentacion    Presentacion @relation(fields: [presentacion_id], references: [id], onDelete: Cascade)

  @@id([perfume_id, presentacion_id])
  @@map("perfume_presentacion")
}

model Venta {
  id                 Int      @id @default(autoincrement())
  dia                DateTime @db.Date
  // Nombre libre mostrado (ej: "hermano de Pepe"); el enlace al cliente es opcional.
  persona            String   @db.VarChar(150)
  // Enlace opcional con la persona (usuario/ficha) que compró.
  user_id            Int?
  cantidad_perfumes  Int
  presentacion       String   @db.VarChar(100)
  referencia_perfume String   @db.Text
  valor_venta        Decimal  @db.Decimal(10, 2)
  datos_adicionales  String?  @db.Text
  // false = pedido registrado pero aún sin pagar; al pasar a true se canjea el
  // código de descuento enlazado (si lo hay).
  pagada             Boolean  @default(true)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  user               User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  // Perfumes del catálogo detectados en la referencia (una venta de combo lleva varios).
  perfumes           VentaPerfume[]
  codigo             DescuentoCodigo?
  // Crédito que generó esta venta (ventas a crédito nacen pendientes de pago)
  credito            Credito?

  @@index([dia])
  @@index([user_id])
  @@map("ventas")
}

// Enlace inferido (por nombre) entre una venta y los perfumes que incluyó;
// alimenta el cálculo automático de "los más vendidos".
model VentaPerfume {
  venta_id   Int
  perfume_id Int
  // Unidades de ESTA fragancia dentro de la venta (un combo de 3 puede llevar
  // 2 del mismo perfume); alimenta el conteo exacto de "los más vendidos".
  cantidad   Int     @default(1) @db.UnsignedSmallInt
  venta      Venta   @relation(fields: [venta_id], references: [id], onDelete: Cascade)
  perfume    Perfume @relation(fields: [perfume_id], references: [id], onDelete: Cascade)

  @@id([venta_id, perfume_id])
  @@index([perfume_id])
  @@map("venta_perfume")
}

model Empresa {
  id         Int             @id @default(autoincrement())
  nombre     String          @db.VarChar(150)
  nit        String?         @db.VarChar(50)
  telefono   String?         @db.VarChar(20)
  correo     String?         @db.VarChar(150)
  direccion  String?         @db.VarChar(255)
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt
  pagos      PagoProveedor[]

  @@map("empresas")
}

model Credito {
  id            Int             @id @default(autoincrement())
  fecha         DateTime        @db.Date
  user_id       Int
  articulos     String          @db.Text
  deuda_inicial Decimal         @db.Decimal(10, 2)
  // Venta enlazada: nace pendiente con el crédito y se marca pagada al saldarlo
  venta_id      Int?            @unique
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  user          User            @relation(fields: [user_id], references: [id])
  venta         Venta?          @relation(fields: [venta_id], references: [id], onDelete: SetNull)
  abonos        CreditoAbono[]

  @@index([user_id])
  @@index([fecha])
  @@map("creditos")
}

model CreditoAbono {
  id         Int      @id @default(autoincrement())
  credito_id Int
  monto      Decimal  @db.Decimal(10, 2)
  fecha      DateTime @default(now()) @db.Date
  created_at DateTime @default(now())
  credito    Credito  @relation(fields: [credito_id], references: [id], onDelete: Cascade)

  @@index([credito_id])
  @@map("credito_abonos")
}

model PagoProveedor {
  id                   Int      @id @default(autoincrement())
  dia                  DateTime @db.Date
  empresa_id           Int
  valor_compra         Decimal  @db.Decimal(10, 2)
  coste_envio          Decimal  @default(0) @db.Decimal(10, 2)
  detalles_adicionales String?  @db.Text
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
  empresa              Empresa  @relation(fields: [empresa_id], references: [id])

  @@index([empresa_id])
  @@index([dia])
  @@map("pagos_proveedor")
}

// Configuración única (fila id=1) de la página pública "Contáctame" estilo linktree.
model ContactoConfig {
  id                Int               @id @default(autoincrement())
  avatar_url        String?           @db.Text
  nombre            String            @default("Celestial Parfums") @db.VarChar(100)
  descripcion       String?           @db.Text
  fondo_tipo        ContactoFondoTipo @default(color)
  // Color hex (#faf8f4) o URL de imagen según fondo_tipo.
  fondo_valor       String?           @db.VarChar(500)
  boton_forma       ContactoForma     @default(redondo)
  boton_color_fondo String            @default("#ffffff") @db.VarChar(20)
  boton_color_texto String            @default("#2f2a3d") @db.VarChar(20)
  // Alineación de cada sección (superior: perfil+botones / inferior: redes) en su mitad.
  contenido_posicion ContactoPosicion      @default(centro)
  redes_posicion     ContactoRedesPosicion @default(centro)
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt

  @@map("contacto_config")
}

// Links de la página Contáctame: botones grandes (tipo boton) o iconos de la
// fila inferior de redes (tipo red, donde `nombre` guarda la plataforma).
model ContactoLink {
  id          Int              @id @default(autoincrement())
  tipo        ContactoLinkTipo @default(boton)
  nombre      String           @db.VarChar(100)
  url         String           @db.Text
  emoji       String?          @db.VarChar(20)
  // Plataforma cuyo icono se muestra en el botón (ej: tiktok); null = usa emoji.
  icono       String?          @db.VarChar(30)
  // Overrides opcionales del estilo global (null = usa el de ContactoConfig).
  forma       ContactoForma?
  color_fondo String?          @db.VarChar(20)
  color_texto String?          @db.VarChar(20)
  orden       Int              @default(0)
  activo      Boolean          @default(true)
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt

  @@index([tipo, activo])
  @@map("contacto_links")
}

model Combo {
  id              Int           @id @default(autoincrement())
  nombre          String        @db.VarChar(150)
  descripcion     String?       @db.Text
  imagen_url      String?       @db.Text
  categoria_id    Int?
  // Presentación de los perfumes del combo (ej: 100ML); null = cualquier tamaño.
  // Permite detectar automáticamente el combo cuando el carrito junta
  // `cantidad` perfumes de esta categoría y presentación.
  presentacion_id Int?
  cantidad        Int
  precio          Decimal       @db.Decimal(10, 2)
  descuento       Int           @default(0) @db.UnsignedTinyInt
  activo          Boolean       @default(true)
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  categoria       Categoria?    @relation(fields: [categoria_id], references: [id], onDelete: SetNull)
  presentacion    Presentacion? @relation(fields: [presentacion_id], references: [id], onDelete: SetNull)

  @@index([categoria_id])
  @@index([presentacion_id])
  @@index([activo])
  @@map("combos")
}
