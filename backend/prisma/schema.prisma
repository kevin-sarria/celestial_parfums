// SIN `output`: el cliente se genera dentro de node_modules y se importa desde
// '@prisma/client'. Con un `output` dentro de src/, `tsc` solo copiaba a dist/
// los .ts compilados (7 archivos) y dejaba fuera el MOTOR de Prisma y su schema
// (los otros 43) -> en local funcionaba (se corre desde src/) pero en el
// servidor `node dist/app.js` arrancaba sin motor. node_modules no lo compila
// nadie, así que ahí el cliente queda completo.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


// ── Enums ───────────────────────────────────────────────────────────────────

enum Genero {
  dama
  caballero
  unisex
}

enum ContactoFondoTipo {
  color
  imagen
}

enum ContactoForma {
  redondo
  cuadrado
}

enum ContactoLinkTipo {
  boton
  red
}

// Alineación vertical de la sección superior (perfil+botones) dentro de su mitad.
enum ContactoPosicion {
  arriba
  centro
}

// Alineación vertical de la sección inferior (redes) dentro de su mitad.
enum ContactoRedesPosicion {
  centro
  abajo
}

enum AnuncioTipo {
  imagen
  mensaje
  descuento
}

enum AnuncioAudiencia {
  todos
  no_registrados
  registrados
}

// Ciclo de vida de un código único de descuento:
// activo (emitido, viaja en el pedido de WhatsApp) → canjeado (la venta se marcó
// pagada) | anulado (el admin lo invalidó; el cupón vuelve a quedar disponible).
enum CodigoEstado {
  activo
  canjeado
  anulado
}

// ── Cotizaciones mayoristas (B2B) ───────────────────────────────────────────

// Qué es un insumo dentro del costeo de producción.
enum InsumoTipo {
  materia_prima
  envase
  accesorio
}

// Cómo se cobra el insumo: por mililitro (esencias, diluyente…) o por pieza.
enum InsumoUnidad {
  ml
  unidad
}

// A qué se le carga el costo del insumo:
//  - unidad: uno por cada perfume (bolsa, perfumero, tarjeta, etiqueta)
//  - pedido: uno por envío completo, sin importar cuántos perfumes lleve
//    (caja de envío, papel burbuja). Multiplicarlo por unidad inflaría el costo.
// Los gastos fijos (impresora, herramientas) NO van aquí: no son costo directo.
enum InsumoAlcance {
  unidad
  pedido
}

enum CotizacionEstado {
  borrador
  enviada
}

// Para qué sirve la cotización:
//  - general:   lista de precios por cantidad (sin decir qué fragancias)
//  - detallada: los productos concretos que se va a llevar el cliente
/// De dónde sale el producto que se vende. Define CÓMO se costea:
///  - fabricado:  lo armas con una receta (contratipos, 1.1). Costo = fórmula.
///  - comprado:   lo compras hecho y lo revendes tal cual (splash, gorras,
///                perfumeros vacíos). Costo = lo que pagaste por él.
///  - fraccionado: compras una botella grande y sacas decants. Costo =
///                (precio botella ÷ ml útiles) × ml del decant + envase.
enum TipoProducto {
  fabricado
  comprado
  fraccionado
}

enum CotizacionTipo {
  general
  detallada
}

// ── Models ──────────────────────────────────────────────────────────────────

model Role {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(50)
  users  User[]

  @@map("roles")
}

// Única lista de personas del sistema: cuentas web reales y "fichas" creadas
// por el admin (sin_cuenta=true, sin acceso) para clientes del negocio que aún
// no se registran. Al registrarse con el mismo correo, la ficha se reclama y
// hereda todo su historial de ventas y créditos.
model User {
  id                 Int       @id @default(autoincrement())
  nombre             String    @db.VarChar(100)
  apellido           String    @db.VarChar(100)
  email              String    @unique @db.VarChar(150)
  password           String    @db.VarChar(255)
  rol_id             Int
  activo             Boolean   @default(false)
  verification_token String?   @db.VarChar(255)
  token_expiry       DateTime?
  telefono           String?   @db.VarChar(20)
  direccion          String?   @db.VarChar(255)
  // Cupo de crédito base fijado por el admin; el factor de comportamiento lo ajusta.
  cupo_base          Decimal   @default(0) @db.Decimal(10, 2)
  // true = ficha creada por el admin, sin acceso a la web todavía.
  sin_cuenta         Boolean   @default(false)
  // Programa de referidos: código propio para invitar y quién lo invitó a él.
  codigo_referido    String?   @unique @db.VarChar(20)
  referido_por       Int?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  rol                Role      @relation(fields: [rol_id], references: [id])
  referidor          User?     @relation("Referidos", fields: [referido_por], references: [id], onDelete: SetNull)
  referidos          User[]    @relation("Referidos")
  ventas             Venta[]
  creditos           Credito[]
  codigos_descuento  DescuentoCodigo[]
  recomendacion      Recomendacion?
  recompensa         RecompensaUsuario?
  resenas            Resena[]
  entregas           RecompensaEntrega[]
  favoritos          Favorito[]
  avisos_stock       AvisoStock[]
  devoluciones       Devolucion[]

  @@map("users")
}

/// Estado de moderación de contenido generado por el cliente (reseñas, fotos).
enum ContenidoEstado {
  pendiente
  aprobada
  rechazada
}

/// Reseña de un perfume por un cliente que lo compró (compra verificada).
/// Aparece pública solo si el admin la aprueba. Una por (cliente, perfume).
model Resena {
  id         Int             @id @default(autoincrement())
  user_id    Int
  perfume_id Int
  rating     Int             @db.UnsignedTinyInt
  comentario String?         @db.Text
  // URLs de las fotos WebP (máximo 3)
  imagenes   Json
  estado     ContenidoEstado @default(pendiente)
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt
  user       User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  perfume    Perfume         @relation(fields: [perfume_id], references: [id], onDelete: Cascade)

  @@unique([user_id, perfume_id])
  @@index([perfume_id, estado])
  @@map("resenas")
}

/// Registro de un premio de fidelidad entregado, con fotos de la entrega para la
/// galería pública de ganadores (aparece solo si el admin la aprueba).
model RecompensaEntrega {
  id         Int             @id @default(autoincrement())
  user_id    Int
  premio     String          @db.VarChar(200)
  imagenes   Json
  estado     ContenidoEstado @default(pendiente)
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt
  user       User            @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([estado])
  @@map("recompensa_entrega")
}

model Categoria {
  id         Int       @id @default(autoincrement())
  nombre     String    @unique @db.VarChar(100)
  // Descuento general de la categoría: los perfumes lo heredan de fondo
  // (se aplica el mayor entre este % y el propio del perfume)
  descuento  Int       @default(0)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  perfumes   Perfume[]
  combos     Combo[]
  anuncios   AnuncioCategoria[]
  precios    PrecioLista[]

  @@map("categorias")
}

/// Lista de precios del negocio: lo que vale UNA presentación dentro de UNA
/// categoría (ej: Contratipo 30ML = 22.000). Es el precio estándar que heredan
/// todos los perfumes de esa categoría; subirlo aquí los sube a todos de golpe.
/// Un perfume puede salirse de la lista con su propio precio (PerfumePresentacion.precio).
model PrecioLista {
  id              Int          @id @default(autoincrement())
  categoria_id    Int
  presentacion_id Int
  precio          Decimal      @db.Decimal(10, 2)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  categoria       Categoria    @relation(fields: [categoria_id], references: [id], onDelete: Cascade)
  presentacion    Presentacion @relation(fields: [presentacion_id], references: [id], onDelete: Cascade)

  @@unique([categoria_id, presentacion_id])
  @@index([presentacion_id])
  @@map("precios")
}

// ── Publicidad: ventanas emergentes configurables del catálogo ──────────────
// tipo imagen/mensaje = informativo; tipo descuento = cupón de un solo uso que
// aplica a las categorías elegidas y/o combos, SIN acumularse con descuentos
// de producto ni con otros cupones.
model Anuncio {
  id            Int              @id @default(autoincrement())
  titulo        String           @db.VarChar(150)
  mensaje       String?          @db.Text
  imagen_url    String?          @db.Text
  tipo          AnuncioTipo      @default(mensaje)
  audiencia     AnuncioAudiencia @default(todos)
  // true = cada visitante lo ve una sola vez; false = en cada visita
  una_vez       Boolean          @default(true)
  activo        Boolean          @default(true)
  orden         Int              @default(0)
  inicio        DateTime?        @db.Date
  fin           DateTime?        @db.Date
  // Solo tipo descuento:
  descuento_pct Int              @default(0) @db.UnsignedTinyInt
  aplica_combos Boolean          @default(false)
  // Reglas para que el cupón aplique en el carrito (0 = sin mínimo):
  // unidades mínimas de productos cubiertos y monto mínimo de esos productos.
  min_unidades  Int              @default(0) @db.UnsignedSmallInt
  min_monto     Decimal          @default(0) @db.Decimal(10, 2)
  // Guardarraíles del cupón (0 = sin límite): tope del descuento en pesos por
  // canje y cupo total de códigos que la campaña puede emitir.
  max_descuento Decimal          @default(0) @db.Decimal(10, 2)
  max_canjes    Int              @default(0) @db.UnsignedSmallInt
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt
  categorias    AnuncioCategoria[]
  codigos       DescuentoCodigo[]

  @@index([activo])
  @@map("anuncios")
}

// Categorías de perfume a las que aplica un cupón (contratipos, 1.1, originales…)
model AnuncioCategoria {
  anuncio_id   Int
  categoria_id Int
  anuncio      Anuncio   @relation(fields: [anuncio_id], references: [id], onDelete: Cascade)
  categoria    Categoria @relation(fields: [categoria_id], references: [id], onDelete: Cascade)

  @@id([anuncio_id, categoria_id])
  @@map("anuncio_categorias")
}

// Código único de descuento emitido al enviar un pedido con cupón. Viaja en el
// mensaje de WhatsApp; el admin lo valida en el dashboard y se canjea (un solo
// uso) al marcar la venta como pagada. Máximo un código activo por persona y
// por tipo de cupón (categorías/combos que cubre).
model DescuentoCodigo {
  id          Int          @id @default(autoincrement())
  codigo      String       @unique @db.VarChar(20)
  anuncio_id  Int
  // null = visitante sin cuenta
  user_id     Int?
  estado      CodigoEstado @default(activo)
  // Venta donde se canjeó (o quedó reservado si la venta sigue pendiente de pago)
  venta_id    Int?         @unique
  created_at  DateTime     @default(now())
  canjeado_at DateTime?
  anuncio     Anuncio @relation(fields: [anuncio_id], references: [id], onDelete: Cascade)
  user        User?   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  venta       Venta?  @relation(fields: [venta_id], references: [id], onDelete: SetNull)

  @@index([user_id, estado])
  @@index([anuncio_id])
  @@map("descuento_codigos")
}

// "Tu perfume ideal": cálculo guardado por usuario. Al volver al apartado se
// muestra tal cual (sin recalcular); solo se recalcula si cambia sus respuestas.
model Recomendacion {
  id         Int      @id @default(autoincrement())
  user_id    Int      @unique
  // Respuestas del quiz (género, edad, ocasiones, aromas, presupuesto, etc.)
  filtros    Json
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items      RecomendacionItem[]

  @@map("recomendaciones")
}

model RecomendacionItem {
  recomendacion_id Int
  perfume_id       Int
  orden            Int
  // Afinidad 0-100 con el perfil de la persona
  puntaje          Int    @db.UnsignedTinyInt
  // JSON string con las razones legibles del match ("Ideal para Citas", ...)
  razones          String @db.Text
  recomendacion    Recomendacion @relation(fields: [recomendacion_id], references: [id], onDelete: Cascade)
  perfume          Perfume       @relation(fields: [perfume_id], references: [id], onDelete: Cascade)

  @@id([recomendacion_id, perfume_id])
  @@index([perfume_id])
  @@map("recomendacion_items")
}

model Perfume {
  id           Int                @id @default(autoincrement())
  nombre       String             @db.VarChar(150)
  descripcion  String?            @db.Text
  /// Precio de respaldo: se usa solo si la presentación no tiene precio propio
  /// ni hay precio en la lista de su categoría. Los precios reales viven en
  /// PrecioLista (por categoría) y PerfumePresentacion.precio (excepciones).
  precio       Decimal            @db.Decimal(10, 2)
  duracion     String?            @db.VarChar(50)
  proyeccion   String?            @db.VarChar(50)
  imagen_url   String?            @db.Text
  genero       Genero?
  categoria_id Int?
  descuento    Int                @default(0) @db.UnsignedTinyInt
  /// Contratipos hechos con la esencia de mayor calidad del laboratorio: valen
  /// mucho más que el resto de su categoría (llevan precio propio) y NUNCA
  /// entran en el precio de combo. Ojo: "premium" describe la ESENCIA, no es
  /// perfumería nicho (Creed, MFK…), que es otra cosa.
  esencia_premium Boolean         @default(false)
  /// Esencia concreta con la que se hace ESTE perfume (Eternity, Khamrah…).
  /// Cada fragancia es un insumo distinto con su propio stock y su propio
  /// costo: promediarlas todas en una sola "Esencia" daría un costo que no es
  /// el de ninguna. Null = todavía sin asignar (se usa la de la fórmula).
  insumo_esencia_id Int?
  /// Cómo se abastece este producto (ver TipoProducto).
  tipo_producto  TipoProducto @default(fabricado)
  /// Para `comprado` y `fraccionado`: el insumo que ES el producto (la gorra,
  /// el splash, la botella original de la que salen los decants). Ahí vive su
  /// stock y su costo real.
  insumo_producto_id Int?
  /// Solo `fraccionado`: cuántos ml SE APROVECHAN de la botella. Es menor que
  /// el volumen nominal porque al trasvasar siempre queda producto en el
  /// frasco y en la jeringa. Sin esto el costo del decant sale más barato de
  /// lo real.
  ml_utiles      Int?
  /// "No hay ahora mismo": SÍ se muestra en la tienda, marcado como agotado, y
  /// el cliente puede pedir que le avisen cuando vuelva.
  agotado      Boolean            @default(false)
  /// Si está en la tienda o no. Es DISTINTO de `agotado`: apagado significa que
  /// el perfume desaparece del catálogo público como si no existiera (no sale
  /// en listados, búsqueda, destacados, detalle ni sitemap). Sirve para lo que
  /// no se puede fabricar —no hay esencia de esa fragancia— y para las fichas
  /// a medio llenar, que no deben verse mientras se completan.
  /// Por defecto TRUE: los 212 perfumes que ya existían siguen publicados.
  publicado    Boolean            @default(true)
  created_at   DateTime           @default(now())
  updated_at   DateTime           @updatedAt
  categoria    Categoria?         @relation(fields: [categoria_id], references: [id], onDelete: SetNull)
  insumo_esencia InsumoCosto?     @relation("EsenciaDePerfume", fields: [insumo_esencia_id], references: [id], onDelete: SetNull)
  insumo_producto InsumoCosto?    @relation("ProductoDeInsumo", fields: [insumo_producto_id], references: [id], onDelete: SetNull)
  tipos_aroma    PerfumeTipoAroma[]
  ocasiones      PerfumeOcasion[]
  presentaciones PerfumePresentacion[]
  ventas         VentaPerfume[]
  recomendado_en RecomendacionItem[]
  resenas        Resena[]
  favoritos      Favorito[]
  avisos_stock   AvisoStock[]
  devoluciones   DevolucionPerfume[]
  cotizado_en    CotizacionItem[]
  producciones   Produccion[]

  @@index([categoria_id])
  @@index([genero])
  @@index([nombre])
  @@map("perfumes")
}

model TipoAroma {
  id         Int                @id @default(autoincrement())
  nombre     String             @unique @db.VarChar(100)
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt
  perfumes   PerfumeTipoAroma[]

  @@map("tipos_aroma")
}

model PerfumeTipoAroma {
  perfume_id    Int
  tipo_aroma_id Int
  perfume       Perfume   @relation(fields: [perfume_id], references: [id], onDelete: Cascade)
  tipo_aroma    TipoAroma @relation(fields: [tipo_aroma_id], references: [id], onDelete: Cascade)

  @@id([perfume_id, tipo_aroma_id])
  @@map("perfume_tipo_aroma")
}

model Ocasion {
  id         Int              @id @default(autoincrement())
  nombre     String           @unique @db.VarChar(100)
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt
  perfumes   PerfumeOcasion[]

  @@map("ocasiones")
}

model PerfumeOcasion {
  perfume_id Int
  ocasion_id Int
  perfume    Perfume @relation(fields: [perfume_id], references: [id], onDelete: Cascade)
  ocasion    Ocasion @relation(fields: [ocasion_id], references: [id], onDelete: Cascade)

  @@id([perfume_id, ocasion_id])
  @@map("perfume_ocasion")
}

model Presentacion {
  id         Int                   @id @default(autoincrement())
  nombre     String                @unique @db.VarChar(20)
  /// Tamaño en MILILITROS: es la verdad de la talla, el `nombre` es solo la
  /// etiqueta que ve el cliente. Nació porque el texto se escribía de cinco
  /// formas ("30ML", "30 ML", "30 ml") y nada casaba; comparando números eso
  /// desaparece. Null = no es un tamaño (ej. una gorra), y esos NO se costean.
  ml         Int?
  /// Qué receta usa esta talla. Enlaza de VERDAD el catálogo público con el
  /// costeo: antes solo coincidían por nombre y por eso el costo buscaba el
  /// insumo equivocado.
  formula_volumen_id Int?
  formula    FormulaVolumen?       @relation(fields: [formula_volumen_id], references: [id], onDelete: SetNull)
  created_at DateTime              @default(now())
  updated_at DateTime              @updatedAt
  perfumes   PerfumePresentacion[]
  combos     Combo[]
  precios    PrecioLista[]

  @@index([ml])
  @@map("presentaciones")
}

model PerfumePresentacion {
  perfume_id      Int
  presentacion_id Int
  /// Excepción a la lista de precios: lo que vale ESTE perfume en ESTA
  /// presentación (los ultra nicho lo usan). null = precio de la lista.
  precio          Decimal?     @db.Decimal(10, 2)
  /// Frasco de ESTE perfume en ESTA talla. El dueño confirmó que el envase y
  /// la caja cambian según la referencia (un 1.1 de Sauvage no usa el mismo
  /// frasco que uno de Bleu), así que no basta con el de la receta del tamaño.
  /// null = usa el envase por defecto de la fórmula.
  envase_insumo_id Int?
  /// Ids de los accesorios propios de esta combinación (caja, tarjeta…).
  /// Vacío o null = usa los accesorios por defecto del tamaño.
  accesorios      Json?
  envase          InsumoCosto? @relation("EnvaseDePerfumeTalla", fields: [envase_insumo_id], references: [id], onDelete: SetNull)
  perfume         Perfume      @relation(fields: [perfume_id], references: [id], onDelete: Cascade)
  presentacion    Presentacion @relation(fields: [presentacion_id], references: [id], onDelete: Cascade)

  @@id([perfume_id, presentacion_id])
  @@map("perfume_presentacion")
}

model Venta {
  id                 Int      @id @default(autoincrement())
  dia                DateTime @db.Date
  // Nombre libre mostrado (ej: "hermano de Pepe"); el enlace al cliente es opcional.
  persona            String   @db.VarChar(150)
  // Enlace opcional con la persona (usuario/ficha) que compró.
  user_id            Int?
  cantidad_perfumes  Int
  presentacion       String   @db.VarChar(100)
  referencia_perfume String   @db.Text
  valor_venta        Decimal  @db.Decimal(10, 2)
  datos_adicionales  String?  @db.Text
  // false = pedido registrado pero aún sin pagar; al pasar a true se canjea el
  // código de descuento enlazado (si lo hay).
  pagada             Boolean  @default(true)
  /// Lo que costó producir lo vendido, congelado al registrar la venta.
  /// Ingresos − esto = ganancia real. 0 = no se pudo costear (producto sin
  /// esencia asignada, sin talla, o venta histórica).
  costo_mercancia    Decimal  @default(0) @db.Decimal(12, 2)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  user               User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  // Perfumes del catálogo detectados en la referencia (una venta de combo lleva varios).
  perfumes           VentaPerfume[]
  codigo             DescuentoCodigo?
  // Crédito que generó esta venta (ventas a crédito nacen pendientes de pago)
  credito            Credito?
  // Devoluciones/reclamos de garantía sobre esta venta
  devoluciones       Devolucion[]

  @@index([dia])
  @@index([user_id])
  @@map("ventas")
}

// Enlace inferido (por nombre) entre una venta y los perfumes que incluyó;
// alimenta el cálculo automático de "los más vendidos".
/// Una LÍNEA de la venta: qué producto, en qué talla y cuántas unidades.
///
/// Antes la clave era (venta_id, perfume_id), así que el MISMO perfume en dos
/// tallas no cabía: vender 1 Khamrah de 30 ml y otro de 100 ml era imposible.
/// Ahora la línea tiene id propio y lo único que no se repite es la
/// combinación producto+talla — dos Khamrah de 30 ml siguen siendo UNA línea
/// con cantidad 2, no dos registros.
model VentaPerfume {
  id         Int     @id @default(autoincrement())
  venta_id   Int
  perfume_id Int
  /// Talla en mililitros. Null = las ventas históricas (que no la guardaban) y
  /// los productos que no son perfume: una gorra no tiene ml. Sin ml NO se
  /// descuenta inventario, porque no se sabe qué receta aplicar.
  ml         Int?
  // Unidades de ESTA fragancia y talla dentro de la venta.
  cantidad   Int     @default(1) @db.UnsignedSmallInt
  venta      Venta   @relation(fields: [venta_id], references: [id], onDelete: Cascade)
  perfume    Perfume @relation(fields: [perfume_id], references: [id], onDelete: Cascade)

  @@unique([venta_id, perfume_id, ml])
  @@index([venta_id])
  @@index([perfume_id])
  @@map("venta_perfume")
}

/// Cómo factura el IVA un proveedor. No es global: el distribuidor principal
/// entrega el precio ya con IVA, otros lo suman aparte, y las compras al
/// exterior no lo cobran. Un porcentaje único contaría el impuesto dos veces.
enum IvaModo {
  /// El valor que da el proveedor YA incluye el IVA.
  incluido
  /// El proveedor da el parcial y el IVA se suma.
  agregado
  /// No cobra IVA (exterior, persona natural).
  sin_iva
}

model Empresa {
  id         Int             @id @default(autoincrement())
  nombre     String          @db.VarChar(150)
  nit        String?         @db.VarChar(50)
  telefono   String?         @db.VarChar(20)
  correo     String?         @db.VarChar(150)
  direccion  String?         @db.VarChar(255)
  /// Se configura UNA vez y todas sus compras la heredan.
  /// `incluido` por defecto: es el comportamiento actual y no infla ningún costo.
  iva_modo   IvaModo         @default(incluido)
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt
  pagos      PagoProveedor[]

  @@map("empresas")
}

/// Configuración tributaria del negocio (fila única, patrón ContactoConfig).
model NegocioConfig {
  id              Int      @id @default(1)
  /// ¿El negocio descuenta el IVA de sus compras ante la DIAN?
  /// false = el IVA es COSTO (sale del bolsillo). true = es descontable y NO
  /// entra al costo. Hoy false: el dueño no está constituido como empresa.
  responsable_iva Boolean  @default(false)
  /// Tasa general vigente. Configurable porque cambia por ley; la tasa usada
  /// se CONGELA en cada compra, así que la historia nunca se reescribe.
  iva_tasa        Decimal  @default(0.19) @db.Decimal(5, 4)
  updated_at      DateTime @updatedAt

  @@map("negocio_config")
}

model Credito {
  id            Int             @id @default(autoincrement())
  fecha         DateTime        @db.Date
  user_id       Int
  articulos     String          @db.Text
  deuda_inicial Decimal         @db.Decimal(10, 2)
  // Acuerdo de pago: fecha límite pactada (por defecto 1 mes desde `fecha`).
  // Si un crédito con cupón sigue con saldo pasada esta fecha, el motor de cupo
  // aplica un castigo extra (el "factor tiempo" jugando en contra del cliente).
  fecha_limite  DateTime?       @db.Date
  // Venta enlazada: nace pendiente con el crédito y se marca pagada al saldarlo
  venta_id      Int?            @unique
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  user          User            @relation(fields: [user_id], references: [id])
  venta         Venta?          @relation(fields: [venta_id], references: [id], onDelete: SetNull)
  abonos        CreditoAbono[]

  @@index([user_id])
  @@index([fecha])
  @@map("creditos")
}

model CreditoAbono {
  id         Int      @id @default(autoincrement())
  credito_id Int
  monto      Decimal  @db.Decimal(10, 2)
  fecha      DateTime @default(now()) @db.Date
  created_at DateTime @default(now())
  credito    Credito  @relation(fields: [credito_id], references: [id], onDelete: Cascade)

  @@index([credito_id])
  @@map("credito_abonos")
}

model PagoProveedor {
  id                   Int      @id @default(autoincrement())
  dia                  DateTime @db.Date
  empresa_id           Int
  valor_compra         Decimal  @db.Decimal(10, 2)
  coste_envio          Decimal  @default(0) @db.Decimal(10, 2)
  detalles_adicionales String?  @db.Text
  /// Número de la factura o remisión del proveedor (para cruzar con el soporte).
  numero_factura       String?  @db.VarChar(60)
  /// URLs de los soportes que manda la distribuidora (imágenes y PDF).
  archivos             Json?
  /// Cómo se liquidó el IVA de ESTA factura. Se hereda del proveedor y se puede
  /// corregir puntualmente. Se CONGELA: cambiar el proveedor mañana no reescribe
  /// una compra de marzo.
  iva_modo             IvaModo?
  /// Tasa aplicada, congelada (la general cambia por ley).
  iva_tasa             Decimal? @db.Decimal(5, 4)
  /// IVA total de la factura, congelado. Hace falta para declarar aunque hoy no
  /// se descuente.
  iva_valor            Decimal  @default(0) @db.Decimal(12, 2)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
  empresa              Empresa  @relation(fields: [empresa_id], references: [id])
  /// Detalle de qué se compró (opcional: los pagos viejos no lo tienen).
  items                CompraItem[]

  @@index([empresa_id])
  @@index([dia])
  @@map("pagos_proveedor")
}

// Configuración única (fila id=1) de la página pública "Contáctame" estilo linktree.
/// Tarjeta de recompensas (fidelidad): configuración GLOBAL. Fila única, como
/// ContactoConfig. Cada compra pagada del cliente ≥ `min_compra` suma un sello;
/// al juntar `sellos_objetivo` gana el `premio`. El admin puede darle a un
/// cliente su propia meta/premio en RecompensaUsuario (override).
model RecompensaConfig {
  id              Int      @id @default(autoincrement())
  activo          Boolean  @default(true)
  sellos_objetivo Int      @default(5)
  premio          String   @default("Un perfume de 10ml GRATIS") @db.VarChar(200)
  // Compra mínima (COP) que da un sello (0 = cualquier compra)
  min_compra      Decimal  @default(0) @db.Decimal(10, 2)
  // Colores de la tarjeta (hex). Personalizables desde el admin.
  color_fondo     String   @default("#141119") @db.VarChar(20)
  color_lineas    String   @default("#d9b45a") @db.VarChar(20)
  color_texto     String   @default("#ffffff") @db.VarChar(20)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("recompensa_config")
}

/// Progreso y override por cliente. Los sellos NO se guardan (se recalculan de
/// las ventas pagadas); solo se guarda cuántos se han consumido en premios ya
/// entregados. Los campos *_override, si no son null, reemplazan a la config global.
model RecompensaUsuario {
  user_id            Int      @id
  // Sellos ya gastados en premios entregados (el admin lo sube al entregar).
  sellos_consumidos  Int      @default(0)
  premios_entregados Int      @default(0)
  // Regla especial para ESTE cliente (null = usa la global)
  objetivo_override  Int?
  premio_override    String?  @db.VarChar(200)
  min_compra_override Decimal? @db.Decimal(10, 2)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("recompensa_usuario")
}

model ContactoConfig {
  id                Int               @id @default(autoincrement())
  avatar_url        String?           @db.Text
  nombre            String            @default("Celestial Parfums") @db.VarChar(100)
  descripcion       String?           @db.Text
  fondo_tipo        ContactoFondoTipo @default(color)
  // Color hex (#faf8f4) o URL de imagen según fondo_tipo.
  fondo_valor       String?           @db.VarChar(500)
  boton_forma       ContactoForma     @default(redondo)
  boton_color_fondo String            @default("#ffffff") @db.VarChar(20)
  boton_color_texto String            @default("#2f2a3d") @db.VarChar(20)
  // Alineación de cada sección (superior: perfil+botones / inferior: redes) en su mitad.
  contenido_posicion ContactoPosicion      @default(centro)
  redes_posicion     ContactoRedesPosicion @default(centro)
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt

  @@map("contacto_config")
}

// Links de la página Contáctame: botones grandes (tipo boton) o iconos de la
// fila inferior de redes (tipo red, donde `nombre` guarda la plataforma).
model ContactoLink {
  id          Int              @id @default(autoincrement())
  tipo        ContactoLinkTipo @default(boton)
  nombre      String           @db.VarChar(100)
  url         String           @db.Text
  emoji       String?          @db.VarChar(20)
  // Plataforma cuyo icono se muestra en el botón (ej: tiktok); null = usa emoji.
  icono       String?          @db.VarChar(30)
  // Overrides opcionales del estilo global (null = usa el de ContactoConfig).
  forma       ContactoForma?
  color_fondo String?          @db.VarChar(20)
  color_texto String?          @db.VarChar(20)
  orden       Int              @default(0)
  activo      Boolean          @default(true)
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt

  @@index([tipo, activo])
  @@map("contacto_links")
}

model Combo {
  id              Int           @id @default(autoincrement())
  nombre          String        @db.VarChar(150)
  descripcion     String?       @db.Text
  imagen_url      String?       @db.Text
  categoria_id    Int?
  // Presentación de los perfumes del combo (ej: 100ML); null = cualquier tamaño.
  // Permite detectar automáticamente el combo cuando el carrito junta
  // `cantidad` perfumes de esta categoría y presentación.
  presentacion_id Int?
  cantidad        Int
  precio          Decimal       @db.Decimal(10, 2)
  descuento       Int           @default(0) @db.UnsignedTinyInt
  activo          Boolean       @default(true)
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  categoria       Categoria?    @relation(fields: [categoria_id], references: [id], onDelete: SetNull)
  presentacion    Presentacion? @relation(fields: [presentacion_id], references: [id], onDelete: SetNull)

  @@index([categoria_id])
  @@index([presentacion_id])
  @@index([activo])
  @@map("combos")
}

// Perfumes guardados por un cliente (favoritos / lista de deseos).
model Favorito {
  id         Int      @id @default(autoincrement())
  user_id    Int
  perfume_id Int
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  perfume    Perfume  @relation(fields: [perfume_id], references: [id], onDelete: Cascade)

  @@unique([user_id, perfume_id])
  @@index([user_id])
  @@map("favoritos")
}

// "Avísame cuando vuelva": interés en un perfume agotado. El admin ve la demanda.
model AvisoStock {
  id         Int      @id @default(autoincrement())
  user_id    Int
  perfume_id Int
  notificado Boolean  @default(false)
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  perfume    Perfume  @relation(fields: [perfume_id], references: [id], onDelete: Cascade)

  @@unique([user_id, perfume_id])
  @@index([perfume_id, notificado])
  @@map("avisos_stock")
}

// Blog: contenido HTML SANEADO en el backend antes de guardar (anti-XSS).
model Post {
  id         Int      @id @default(autoincrement())
  titulo     String   @db.VarChar(200)
  slug       String   @unique @db.VarChar(220)
  resumen    String?  @db.VarChar(300)
  contenido  String   @db.Text
  portada    String?  @db.VarChar(255)
  publicado  Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([publicado, created_at])
  @@map("posts")
}

// Config de "Sobre nosotros" (fila única, patrón ContactoConfig).
model SobreNosotrosConfig {
  id         Int      @id @default(autoincrement())
  titulo     String   @default("Sobre nosotros") @db.VarChar(200)
  historia   String   @default("") @db.Text
  imagen     String?  @db.VarChar(255)
  activo     Boolean  @default(true)
  updated_at DateTime @updatedAt

  @@map("sobre_nosotros_config")
}

// ── Cotizaciones mayoristas (B2B) — módulo 100% interno (solo admin) ────────
// Diseñado independiente del catálogo público y del (inexistente) inventario:
// los costos los teclea el admin y viven aquí, listos para conectarse a un
// módulo de inventario/compras el día que exista, sin rehacer nada.

// Insumo con su costo actual: esencias, diluyente, envases, bolsas, etiquetas…
// Catálogo abierto: el admin agrega los que necesite sin tocar el código.
/// Gama de una esencia: la CALIDAD de la esencia pura (clásica, árabe, premium,
/// diseñador…). Es una TABLA y no una lista fija en el código a propósito: el
/// dueño quiere poder agregar "nicho", "nicho premium" y las que vengan sin que
/// haga falta tocar la base de datos ni publicar una versión nueva.
///
/// Para qué sirve: costear cuando todavía NO se sabe qué fragancia se va a
/// armar. La cotización general al mayoreo dice "50 de 30 ml" sin decir cuáles,
/// y costear eso con una esencia cualquiera da un margen que no es de nadie.
/// Cuando el perfume sí se conoce, manda SU esencia, no la gama.
model GamaEsencia {
  id         Int      @id @default(autoincrement())
  nombre     String   @unique @db.VarChar(60)
  /// Para listarlas de la más barata a la más cara, que es como se leen.
  orden      Int      @default(0) @db.SmallInt
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  esencias   InsumoCosto[]

  @@map("gamas_esencia")
}

model InsumoCosto {
  id         Int          @id @default(autoincrement())
  nombre     String       @db.VarChar(120)
  tipo       InsumoTipo
  unidad     InsumoUnidad @default(unidad)
  /// Se cobra por cada perfume o una sola vez por pedido.
  alcance    InsumoAlcance @default(unidad)
  /// Costo actual por ml (materias primas) o por pieza (envases/accesorios).
  /// Desde que existen las compras detalladas, NO se teclea: es el **costo
  /// promedio ponderado** que recalcula `recalcularCosto` con cada movimiento.
  /// Editable a mano solo para sembrar el arranque.
  /// 4 decimales: el promedio ponderado da fracciones y redondear a 2 en cada
  /// compra iría torciendo el costo poco a poco.
  precio     Decimal      @db.Decimal(12, 4)
  /// Cantidad disponible en la unidad base del insumo (ml o piezas).
  /// Es una proyección del libro de movimientos, no la verdad última.
  stock      Decimal      @default(0) @db.Decimal(12, 3)
  /// Punto de pedido: cuando el stock baja de aquí, hay que reponer. En 0 se
  /// desactiva la alerta (no todo insumo la necesita).
  stock_minimo Decimal    @default(0) @db.Decimal(12, 3)
  /// Solo para esencias: a qué gama pertenece (ver GamaEsencia). Null en todo
  /// lo demás: un frasco o el diluyente no tienen gama.
  gama_id    Int?
  gama       GamaEsencia? @relation(fields: [gama_id], references: [id], onDelete: SetNull)
  /// Para quién es la fragancia que sale de esta esencia. Solo aplica a
  /// esencias. Null = todavía no se ha dicho (la mayoría: el dueño solo lo
  /// escribía en el nombre cuando necesitaba desempatar dos fragancias de la
  /// misma línea, así que solo 27 de 216 lo traían). Sirve para que el perfume
  /// que nace de una compra salga ya clasificado y para descartar candidatos
  /// del género equivocado al emparejar esencias con perfumes.
  genero     Genero?
  activo     Boolean      @default(true)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  /// Fórmulas que usan este insumo como envase (impide borrarlo si está en uso).
  envase_de  FormulaVolumen[] @relation("EnvaseDeFormula")
  /// Fórmulas que usan este insumo como esencia (normal, premium…).
  esencia_de FormulaVolumen[] @relation("EsenciaDeFormula")
  /// Tamaños que lo incluyen por defecto (bolsa, perfumero…).
  incluido_en FormulaAccesorio[]
  /// Líneas de compra y movimientos de inventario de este insumo.
  compras     CompraItem[]
  movimientos MovimientoInventario[]
  /// Perfumes que se hacen con esta esencia.
  esencia_de_perfumes Perfume[] @relation("EsenciaDePerfume")
  /// Productos comprados o fraccionados que SON este insumo.
  producto_de         Perfume[] @relation("ProductoDeInsumo")
  /// Combinaciones perfume+talla que usan este insumo como frasco.
  envase_de_talla     PerfumePresentacion[] @relation("EnvaseDePerfumeTalla")

  @@index([tipo, activo])
  @@map("insumos_costo")
}

// ── Inventario ──────────────────────────────────────────────────────────────

/// En qué unidad vino la compra. El proveedor factura ml y gramos **1 a 1**
/// (así lo maneja el sector), por eso `g` se guarda como ml sin convertir por
/// densidad. NO "arreglar" esto metiendo densidades: descuadraría contra la
/// factura que el proveedor emitió.
enum UnidadCompra {
  ml
  g
  /// Litros y kilos se convierten ×1000 a ml. Como ml y gramos van 1 a 1 (la
  /// densidad de las esencias lo permite), 1 L = 1 kg = 1000 ml. SIN esto,
  /// teclear "20 L" de alcohol se registraba como 20 ml y el costo por ml
  /// quedaba 1000 veces inflado.
  l
  kg
  unidad
}

/// Por qué se movió el inventario. Cada movimiento guarda el costo unitario
/// del momento, así el histórico no cambia cuando suba el precio del insumo.
enum MovimientoTipo {
  compra
  produccion
  garantia
  /// Conteo físico: absorbe el desperdicio pequeño del día a día (los gramos
  /// que se van de más al servir). No hace falta anotar cada accidente.
  ajuste
  /// Derrame, frasco roto, esencia dañada: pérdida identificada.
  merma
  /// Material que sale a propósito y no se vende: rolones del mostrario,
  /// minis de regalo. Es COSTO DE MARKETING, no pérdida — por eso va aparte.
  muestra
  /// Consumo por una VENTA. Como se arma contra pedido, la venta es la que
  /// gasta los insumos; de aquí sale el costo de mercancía vendida.
  venta
}

/// Línea de una compra a proveedor: qué insumo, cuánto y a qué precio.
/// El flete de la compra se reparte proporcional entre las líneas
/// (`costo_unitario_final`), porque el transporte ES parte de lo que te
/// costó el material: ignorarlo infla los márgenes.
model CompraItem {
  id                   Int          @id @default(autoincrement())
  pago_id              Int
  insumo_id            Int
  cantidad             Decimal      @db.Decimal(12, 3)
  unidad_compra        UnidadCompra @default(unidad)
  /// Lo que costó la línea sin flete.
  subtotal             Decimal      @db.Decimal(12, 2)
  /// Costo por unidad YA con la parte proporcional del flete (congelado).
  costo_unitario_final Decimal      @db.Decimal(12, 4)
  /// Desglose del impuesto, congelado. Guardar base y valor por línea (y no solo
  /// el total) es lo que permite declarar y, más adelante, facturar.
  base_gravable        Decimal?     @db.Decimal(12, 4)
  iva_valor            Decimal?     @db.Decimal(12, 4)
  created_at           DateTime     @default(now())

  pago   PagoProveedor @relation(fields: [pago_id], references: [id], onDelete: Cascade)
  insumo InsumoCosto   @relation(fields: [insumo_id], references: [id])

  @@index([pago_id])
  @@index([insumo_id])
  @@map("compra_items")
}

/// Libro de movimientos: la verdad auditable del inventario. `stock` y el
/// costo promedio de `insumos_costo` son una proyección de esto y se pueden
/// reconstruir desde aquí si algo se descuadra.
model MovimientoInventario {
  id             Int            @id @default(autoincrement())
  insumo_id      Int
  tipo           MovimientoTipo
  /// Positiva entra, negativa sale (en la unidad base del insumo).
  cantidad       Decimal        @db.Decimal(12, 3)
  /// Costo unitario aplicado en ESE momento (congelado).
  costo_unitario Decimal        @db.Decimal(12, 4)
  fecha          DateTime       @db.Date
  /// De dónde vino: id de la compra, producción o devolución que lo generó.
  referencia_id  Int?
  nota           String?        @db.VarChar(255)
  created_at     DateTime       @default(now())

  insumo InsumoCosto @relation(fields: [insumo_id], references: [id], onDelete: Cascade)

  @@index([insumo_id, fecha])
  @@index([tipo])
  @@map("movimientos_inventario")
}

// Accesorios que un tamaño incluye POR DEFECTO. Al cotizar vienen marcados y se
// pueden quitar o agregar otros para ese cliente: el set es un punto de partida,
// no una regla fija (mañana puede ser una tarjeta personalizada en vez de bolsa).
model FormulaAccesorio {
  formula_volumen_id Int
  insumo_id          Int
  formula            FormulaVolumen @relation(fields: [formula_volumen_id], references: [id], onDelete: Cascade)
  insumo             InsumoCosto    @relation(fields: [insumo_id], references: [id], onDelete: Cascade)

  @@id([formula_volumen_id, insumo_id])
  @@index([insumo_id])
  @@map("formula_accesorios")
}

// Tamaño fabricable (30/50/100 ml…) con su fórmula. El diluyente NO se guarda:
// siempre se calcula como ml_total − esencia − sellador − feromonas, para que no
// pueda quedar desincronizado si se edita el volumen total.
model FormulaVolumen {
  id               Int      @id @default(autoincrement())
  nombre           String   @db.VarChar(60)
  ml_total         Int
  esencia_ml       Decimal  @db.Decimal(6, 2)
  sellador_ml      Decimal  @default(0) @db.Decimal(6, 2)
  feromonas_ml     Decimal  @default(0) @db.Decimal(6, 2)
  /// Envase que usa este tamaño (un InsumoCosto de tipo envase).
  envase_insumo_id Int?
  /// Esencia concreta de esta receta (normal, premium…). Sin ella el costeo
  /// tendría que adivinar cuál usar cuando hay varias esencias cargadas.
  esencia_insumo_id Int?
  activo           Boolean  @default(true)
  orden            Int      @default(0)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  envase           InsumoCosto?    @relation("EnvaseDeFormula", fields: [envase_insumo_id], references: [id], onDelete: SetNull)
  esencia          InsumoCosto?    @relation("EsenciaDeFormula", fields: [esencia_insumo_id], references: [id], onDelete: SetNull)
  escalas          EscalaPrecio[]
  items            CotizacionItem[]
  accesorios       FormulaAccesorio[]
  producciones     Produccion[]
  presentaciones   Presentacion[]

  @@index([activo])
  @@map("formulas_volumen")
}

// Precio mayorista por rango de cantidad, para un tamaño concreto.
// El rango se evalúa por LÍNEA de la cotización (cada producto según SU cantidad).
model EscalaPrecio {
  id                 Int            @id @default(autoincrement())
  formula_volumen_id Int
  cantidad_min       Int
  /// null = sin tope superior (el clásico "100+").
  cantidad_max       Int?
  precio             Decimal        @db.Decimal(10, 2)
  formula            FormulaVolumen @relation(fields: [formula_volumen_id], references: [id], onDelete: Cascade)

  @@index([formula_volumen_id, cantidad_min])
  @@map("escalas_precio")
}

// Textos y valores por defecto de las cotizaciones (fila única).
model CotizacionConfig {
  id                     Int      @id @default(autoincrement())
  vigencia_dias_default  Int      @default(15)
  /// Objeto con pedido_minimo, tiempo_preparacion, tiempo_despacho, forma_pago,
  /// condiciones_pago, costos_envio, garantias, politica_cambios.
  condiciones_comerciales Json
  /// Array de strings: bloque "¿Por qué elegir Celestial Parfums?".
  beneficios_items       Json
  /// Array de strings: cláusulas legales del pie del PDF.
  avisos_legales         Json
  updated_at             DateTime @updatedAt

  @@map("cotizacion_config")
}

// Plantilla comercial reutilizable (Mayorista, Distribuidor, Premium…).
// El nombre es libre: no es un enum fijo, el admin crea las que quiera.
model PlantillaCotizacion {
  id                      Int           @id @default(autoincrement())
  nombre                  String        @db.VarChar(80)
  descuento_pct           Decimal       @default(0) @db.Decimal(5, 2)
  /// Mismo shape que CotizacionConfig.condiciones_comerciales; sobreescribe el default.
  condiciones_comerciales Json?
  observaciones_default   String?       @db.Text
  activo                  Boolean       @default(true)
  created_at              DateTime      @default(now())
  updated_at              DateTime      @updatedAt
  cotizaciones            Cotizacion[]

  @@map("plantillas_cotizacion")
}

// Cabecera de la cotización. Los datos del cliente van en texto libre a
// propósito: un prospecto mayorista no es un User del sitio ni una Empresa
// (que en este proyecto son PROVEEDORES, tabla pagos_proveedor).
model Cotizacion {
  id                      Int              @id @default(autoincrement())
  numero                  String           @unique @db.VarChar(20)
  tipo                    CotizacionTipo   @default(detallada)
  /// Solo en las GENERALES: lista de precios congelada
  /// [{volumen, escalas:[{desde, hasta, precio}]}]. Se guarda tal cual para que
  /// la cotización enviada no cambie si mañana se ajustan los precios.
  lista_precios           Json?
  cliente_nombre          String           @db.VarChar(150)
  cliente_empresa         String?          @db.VarChar(150)
  cliente_telefono        String?          @db.VarChar(30)
  cliente_email           String?          @db.VarChar(150)
  cliente_nit             String?          @db.VarChar(50)
  plantilla_id            Int?
  subtotal                Decimal          @default(0) @db.Decimal(10, 2)
  descuento_pct           Decimal          @default(0) @db.Decimal(5, 2)
  total                   Decimal          @default(0) @db.Decimal(10, 2)
  vigencia_dias           Int              @default(15)
  fecha_vigencia          DateTime         @db.Date
  /// Snapshot editable: se copia del config/plantilla al crear.
  condiciones_comerciales Json
  /// Insumos de alcance "pedido" cargados a ESTA cotización (caja de envío…),
  /// congelados: [{insumo_id, nombre, precio}]. Van una vez, no por unidad.
  extras_pedido           Json?
  observaciones           String?          @db.Text
  estado                  CotizacionEstado @default(borrador)
  created_at              DateTime         @default(now())
  updated_at              DateTime         @updatedAt
  plantilla               PlantillaCotizacion? @relation(fields: [plantilla_id], references: [id], onDelete: SetNull)
  items                   CotizacionItem[]

  @@index([estado, created_at])
  @@map("cotizaciones")
}

// Línea de la cotización. Congela nombre, accesorios y desglose de costo: si
// mañana sube el precio de la esencia, una cotización vieja NO debe cambiar su
// rentabilidad histórica (mismo criterio que la deuda de un crédito).
model CotizacionItem {
  id                      Int            @id @default(autoincrement())
  cotizacion_id           Int
  perfume_id              Int?
  /// Nombre congelado del perfume (sobrevive a renombres o borrados).
  perfume_nombre          String         @db.VarChar(150)
  formula_volumen_id      Int?
  /// Nombre congelado del tamaño (ej: "30 ml").
  volumen_nombre          String         @db.VarChar(60)
  cantidad                Int
  /// Accesorios incluidos en ESTA línea: [{insumo_id, nombre, precio}].
  accesorios_seleccionados Json
  /// SOLO ADMIN — nunca viaja al PDF del cliente:
  /// {esencia, diluyente, sellador, feromonas, envase, accesorios, costo_unitario}.
  desglose_costo          Json
  precio_unitario         Decimal        @db.Decimal(10, 2)
  subtotal                Decimal        @db.Decimal(10, 2)
  orden                   Int            @default(0)
  cotizacion              Cotizacion     @relation(fields: [cotizacion_id], references: [id], onDelete: Cascade)
  perfume                 Perfume?       @relation(fields: [perfume_id], references: [id], onDelete: SetNull)
  formula                 FormulaVolumen? @relation(fields: [formula_volumen_id], references: [id], onDelete: SetNull)

  @@index([cotizacion_id])
  @@map("cotizacion_items")
}

// ── Devoluciones y garantías ─────────────────────────────────────────────────

/// Por qué el cliente devuelve. Alineado con lo que cubre la garantía legal
/// según `/legal#devoluciones` (Ley 1480 de 2011).
enum DevolucionMotivo {
  llego_danado
  llego_equivocado
  llego_incompleto
  envase_defectuoso
  no_llego
  otro
}

/// Estado del caso. `pendiente` es donde nace una solicitud del cliente
/// (fase C); el admin la mueve a resuelta o rechazada.
enum DevolucionEstado {
  pendiente
  en_revision
  resuelta
  rechazada
}

/// Qué se hizo. `ninguna` cubre el caso resuelto sin plata de por medio
/// (ej: se aclaró con el cliente y no procedía).
enum DevolucionSolucion {
  reposicion
  devolucion_dinero
  ninguna
}

/// Quién radicó el caso. `cliente` se usará cuando exista el portal (fase C).
enum DevolucionOrigen {
  admin
  cliente
}

/// Devolución/reclamo de garantía ligado SIEMPRE a una venta: así se sabe qué
/// plata sale y de dónde. Si se devolvió dinero, `monto_devuelto` se descuenta
/// de los ingresos del mes en que se resolvió (ver getVentaTotales).
model Devolucion {
  id                Int                 @id @default(autoincrement())
  venta_id          Int
  /// Quien radicó el caso, si vino del portal del cliente (fase C).
  user_id           Int?
  origen            DevolucionOrigen    @default(admin)
  /// Fecha en que el cliente reportó el problema (arranca el conteo de días).
  fecha             DateTime            @db.Date
  motivo            DevolucionMotivo
  detalle           String?             @db.Text
  estado            DevolucionEstado    @default(pendiente)
  solucion          DevolucionSolucion?
  /// Plata efectivamente devuelta. 0 si se repuso el producto.
  monto_devuelto    Decimal             @default(0) @db.Decimal(10, 2)
  fecha_resolucion  DateTime?           @db.Date
  notas             String?             @db.Text
  /// URLs de las fotos del producto (las sube el admin o el cliente en fase C).
  imagenes          Json?
  /// Tamaño repuesto y cuántas unidades, para valorar la pérdida al costo real
  /// de producción (no al precio de venta: la venta original ya se cobró).
  reposicion_formula_id Int?
  reposicion_cantidad   Int      @default(0)
  /// Costo de producir lo repuesto + envío que asumimos. Se congela al cerrar.
  costo_reposicion      Decimal  @default(0) @db.Decimal(12, 2)
  costo_envio           Decimal  @default(0) @db.Decimal(12, 2)
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt

  venta             Venta               @relation(fields: [venta_id], references: [id], onDelete: Cascade)
  user              User?               @relation(fields: [user_id], references: [id], onDelete: SetNull)
  perfumes          DevolucionPerfume[]

  @@index([venta_id])
  @@index([estado])
  @@index([fecha])
  @@map("devoluciones")
}

/// Qué unidades de qué fragancia vuelven (una venta de combo puede devolver
/// solo una de las tres).
model DevolucionPerfume {
  devolucion_id Int
  perfume_id    Int
  cantidad      Int        @default(1) @db.UnsignedSmallInt
  devolucion    Devolucion @relation(fields: [devolucion_id], references: [id], onDelete: Cascade)
  perfume       Perfume    @relation(fields: [perfume_id], references: [id], onDelete: Cascade)

  @@id([devolucion_id, perfume_id])
  @@index([perfume_id])
  @@map("devolucion_perfume")
}

/// Un lote armado: "hice 10 perfumes de 30 ml". Descuenta del inventario los
/// insumos de la fórmula y congela lo que costó ese lote, para que el histórico
/// no cambie cuando suba la esencia.
model Produccion {
  id                 Int      @id @default(autoincrement())
  fecha              DateTime @db.Date
  formula_volumen_id Int
  /// Qué fragancia se armó (de ahí sale la esencia que se descuenta).
  perfume_id         Int?
  /// Envase realmente usado (el mismo tamaño puede llevar normal o luxury).
  envase_insumo_id   Int?
  /// Unidades armadas.
  cantidad           Int
  /// Costo de UNA unidad y del lote entero, al promedio del momento.
  costo_unitario     Decimal  @db.Decimal(12, 4)
  costo_total        Decimal  @db.Decimal(12, 2)
  nota               String?  @db.VarChar(255)
  created_at         DateTime @default(now())

  formula FormulaVolumen @relation(fields: [formula_volumen_id], references: [id])
  perfume Perfume?       @relation(fields: [perfume_id], references: [id], onDelete: SetNull)

  @@index([fecha])
  @@map("producciones")
}
