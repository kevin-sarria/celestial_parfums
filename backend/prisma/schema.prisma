generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


// ── Enums ───────────────────────────────────────────────────────────────────

enum Genero {
  hombre
  mujer
}

// ── Models ──────────────────────────────────────────────────────────────────

model Role {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(50)
  users  User[]

  @@map("roles")
}

model User {
  id                 Int       @id @default(autoincrement())
  nombre             String    @db.VarChar(100)
  apellido           String    @db.VarChar(100)
  email              String    @unique @db.VarChar(150)
  password           String    @db.VarChar(255)
  rol_id             Int
  activo             Boolean   @default(false)
  verification_token String?   @db.VarChar(255)
  token_expiry       DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  rol                Role      @relation(fields: [rol_id], references: [id])

  @@map("users")
}

model Categoria {
  id         Int       @id @default(autoincrement())
  nombre     String    @unique @db.VarChar(100)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  perfumes   Perfume[]
  combos     Combo[]

  @@map("categorias")
}

model Perfume {
  id           Int                @id @default(autoincrement())
  nombre       String             @db.VarChar(150)
  descripcion  String?            @db.Text
  precio       Decimal            @db.Decimal(10, 2)
  duracion     String?            @db.VarChar(50)
  proyeccion   String?            @db.VarChar(50)
  imagen_url   String?            @db.Text
  genero       Genero?
  categoria_id Int?
  descuento    Int                @default(0) @db.UnsignedTinyInt
  agotado      Boolean            @default(false)
  created_at   DateTime           @default(now())
  updated_at   DateTime           @updatedAt
  categoria    Categoria?         @relation(fields: [categoria_id], references: [id], onDelete: SetNull)
  tipos_aroma    PerfumeTipoAroma[]
  ocasiones      PerfumeOcasion[]
  presentaciones PerfumePresentacion[]

  @@map("perfumes")
}

model TipoAroma {
  id         Int                @id @default(autoincrement())
  nombre     String             @unique @db.VarChar(100)
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt
  perfumes   PerfumeTipoAroma[]

  @@map("tipos_aroma")
}

model PerfumeTipoAroma {
  perfume_id    Int
  tipo_aroma_id Int
  perfume       Perfume   @relation(fields: [perfume_id], references: [id], onDelete: Cascade)
  tipo_aroma    TipoAroma @relation(fields: [tipo_aroma_id], references: [id], onDelete: Cascade)

  @@id([perfume_id, tipo_aroma_id])
  @@map("perfume_tipo_aroma")
}

model Ocasion {
  id         Int              @id @default(autoincrement())
  nombre     String           @unique @db.VarChar(100)
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt
  perfumes   PerfumeOcasion[]

  @@map("ocasiones")
}

model PerfumeOcasion {
  perfume_id Int
  ocasion_id Int
  perfume    Perfume @relation(fields: [perfume_id], references: [id], onDelete: Cascade)
  ocasion    Ocasion @relation(fields: [ocasion_id], references: [id], onDelete: Cascade)

  @@id([perfume_id, ocasion_id])
  @@map("perfume_ocasion")
}

model Presentacion {
  id         Int                   @id @default(autoincrement())
  nombre     String                @unique @db.VarChar(20)
  created_at DateTime              @default(now())
  updated_at DateTime              @updatedAt
  perfumes   PerfumePresentacion[]

  @@map("presentaciones")
}

model PerfumePresentacion {
  perfume_id      Int
  presentacion_id Int
  perfume         Perfume      @relation(fields: [perfume_id], references: [id], onDelete: Cascade)
  presentacion    Presentacion @relation(fields: [presentacion_id], references: [id], onDelete: Cascade)

  @@id([perfume_id, presentacion_id])
  @@map("perfume_presentacion")
}

model Venta {
  id                 Int      @id @default(autoincrement())
  dia                DateTime @db.Date
  persona            String   @db.VarChar(150)
  cantidad_perfumes  Int
  presentacion       String   @db.VarChar(20)
  referencia_perfume String   @db.Text
  valor_venta        Decimal  @db.Decimal(10, 2)
  datos_adicionales  String?  @db.Text
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@map("ventas")
}

model Cliente {
  id         Int       @id @default(autoincrement())
  nombre     String    @db.VarChar(100)
  apellido   String    @db.VarChar(100)
  correo     String?   @db.VarChar(150)
  telefono   String?   @db.VarChar(20)
  direccion  String?   @db.VarChar(255)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  creditos   Credito[]

  @@map("clientes")
}

model Empresa {
  id         Int             @id @default(autoincrement())
  nombre     String          @db.VarChar(150)
  nit        String?         @db.VarChar(50)
  telefono   String?         @db.VarChar(20)
  correo     String?         @db.VarChar(150)
  direccion  String?         @db.VarChar(255)
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt
  pagos      PagoProveedor[]

  @@map("empresas")
}

model Credito {
  id            Int      @id @default(autoincrement())
  fecha         DateTime @db.Date
  cliente_id    Int
  articulos     String   @db.Text
  deuda_inicial Decimal  @db.Decimal(10, 2)
  abono_1       Decimal? @db.Decimal(10, 2)
  abono_2       Decimal? @db.Decimal(10, 2)
  abono_3       Decimal? @db.Decimal(10, 2)
  abono_4       Decimal? @db.Decimal(10, 2)
  abono_5       Decimal? @db.Decimal(10, 2)
  abono_6       Decimal? @db.Decimal(10, 2)
  abono_7       Decimal? @db.Decimal(10, 2)
  abono_8       Decimal? @db.Decimal(10, 2)
  abono_9       Decimal? @db.Decimal(10, 2)
  abono_10      Decimal? @db.Decimal(10, 2)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  cliente       Cliente  @relation(fields: [cliente_id], references: [id])

  @@map("creditos")
}

model PagoProveedor {
  id                   Int      @id @default(autoincrement())
  dia                  DateTime @db.Date
  empresa_id           Int
  valor_compra         Decimal  @db.Decimal(10, 2)
  coste_envio          Decimal  @default(0) @db.Decimal(10, 2)
  detalles_adicionales String?  @db.Text
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
  empresa              Empresa  @relation(fields: [empresa_id], references: [id])

  @@map("pagos_proveedor")
}

model Combo {
  id           Int        @id @default(autoincrement())
  nombre       String     @db.VarChar(150)
  descripcion  String?    @db.Text
  imagen_url   String?    @db.Text
  categoria_id Int?
  cantidad     Int
  precio       Decimal    @db.Decimal(10, 2)
  descuento    Int        @default(0) @db.UnsignedTinyInt
  activo       Boolean    @default(true)
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt
  categoria    Categoria? @relation(fields: [categoria_id], references: [id], onDelete: SetNull)

  @@map("combos")
}
