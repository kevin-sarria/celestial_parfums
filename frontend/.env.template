# ── Celestial Parfums · Frontend ──────────────────────────────────────────────
# Copia este archivo como `.env` y completa los valores para tu entorno.
#   cp .env.template .env
# Las variables deben comenzar con VITE_ para que Vite las exponga al cliente.

# URL base del backend (sin slash final). Ej: http://localhost:4000 o https://api.tudominio.com
VITE_API_URL=http://localhost:4000

# Clave PUBLICA (site key) de Google reCAPTCHA v3 — https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=tu_site_key_de_recaptcha

# Google Sign-In: Client ID del cliente OAuth web (mismo que el backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=
