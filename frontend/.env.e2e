# Configuración de la tienda cuando la levantan los recorridos de navegador
# (`cd backend && npm run test:e2e`). Vite la toma con `--mode e2e` y pisa a
# `.env`, así que la tienda de pruebas habla con el backend de pruebas —el del
# puerto 4100, conectado a `perfumes_test`— y nunca con el de siempre.
VITE_API_URL=http://localhost:4100

# Vacía a propósito: los recorridos no pasan por el formulario de login (la
# sesión se pide al backend y se inyecta en el navegador), así que no hace falta
# cargar el script de Google ni depender de que haya internet.
VITE_RECAPTCHA_SITE_KEY=
VITE_GOOGLE_CLIENT_ID=
